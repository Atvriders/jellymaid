# Copy this file to .env and fill in the values docker-compose.yml references.

# Match to the uid:gid that owns your media library on the host (`id -u` / `id -g`).
# Defaults to 1000:1000 if left unset — see the `user:` comment in docker-compose.yml.
PUID=
PGID=

JELLYFIN_API_KEY=
QBIT_USER=
QBIT_PASS=
# Optional pair — leave BOTH blank if you don't run Radarr; fill in BOTH to use it.
RADARR_URL=
RADARR_API_KEY=
# Optional pair — leave BOTH blank if you don't run Sonarr; fill in BOTH to use it.
SONARR_URL=
SONARR_API_KEY=
