# Copy this file to .env and fill in the values docker-compose.yml references.

# Match to the uid:gid that owns your media library on the host (`id -u` / `id -g`).
# Defaults to 99:100 (Unraid's nobody:users) if left unset — see the `user:` comment in docker-compose.yml.
PUID=
PGID=

JELLYFIN_API_KEY=

# qBittorrent credentials, PER INSTANCE and OPTIONAL. The instances themselves are named in
# QBIT_INSTANCES in docker-compose.yml; each one reads QBIT_<ID>_USER and QBIT_<ID>_PASS, where <ID>
# is its id in capitals with "-" written "_" (id box-a -> QBIT_BOX_A_USER). If you rename an
# instance or add a third, add its two variables here AND to docker-compose.yml.
# Leave BOTH of an instance blank when it lets this host in without a login; fill in BOTH when it
# asks for one. A username without a password (or the reverse) stops the container at start.
# A qBittorrent on the SAME host as this container usually needs them even if your LAN does not —
# see the Unraid same-host note in docker-compose.yml.
# A password here is taken verbatim: no percent-encoding (unlike one embedded in a QBIT_INSTANCES
# URL, where "," must be %2C). Wrap it in single quotes if it contains $, # or a space.
QBIT_BOX_A_USER=
QBIT_BOX_A_PASS=
QBIT_BOX_B_USER=
QBIT_BOX_B_PASS=

# Optional pairs, read only if you uncomment the matching lines in docker-compose.yml.
# Leave BOTH of a pair blank if you don't run it; fill in BOTH to use it.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
