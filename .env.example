# Copy this file to .env and fill in the values docker-compose.yml references.

# Match to the uid:gid that owns your media library on the host (`id -u` / `id -g`).
# Defaults to 1000:1000 if left unset — see the `user:` comment in docker-compose.yml.
PUID=
PGID=

JELLYFIN_API_KEY=
QBIT_USER=
QBIT_PASS=
# Optional — leave both blank together if you don't run Radarr.
RADARR_API_KEY=
# Optional — leave both blank together if you don't run Sonarr.
SONARR_API_KEY=
